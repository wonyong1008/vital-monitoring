# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/vitaldb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=vital
DB_PASSWORD=secret
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# Auth
AUTH_TOKEN=your-secure-bearer-token-here

# Inference
VITAL_RISK_TIME_WINDOW_HOURS=24
